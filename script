local moving = false
local currentIndex = 1
local waitTime = 1

ScreenGui.Parent = player:WaitForChild("PlayerGui")
UIButton.Size = UDim2.new(0, 100, 0, 50)
UIButton.Position = UDim2.new(1, -110, 0, 10)
UIButton.Text = "Autofarm"
UIButton.Parent = ScreenGui

local function teleportToPosition(position)
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = CFrame.new(position)
    end
end

local function onToggleTeleport()
    moving = not moving
    if moving then
        while moving do
            teleportToPosition(positions[currentIndex])
            currentIndex = currentIndex + 1
            if currentIndex > #positions then
                currentIndex = 1
            end
            wait(waitTime)
        end
    end
end

UIButton.MouseButton1Click:Connect(onToggleTeleport)

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end
    if input.KeyCode == Enum.KeyCode.E and not UserInputService.TouchEnabled then
        onToggleTeleport()
    end
end)
